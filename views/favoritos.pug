        document.getElementById('modal-portions').textContent = fav.Porciones || '-';

        const instrEl = document.getElementById('modal-instructions');
        if (fav.Instrucciones && fav.Instrucciones !== 'Sin instrucciones disponibles.') {
          instrEl.innerHTML = fav.Instrucciones
            .split('\n')
            .filter(l => l.trim())
            .map(l => `<p class="mb-2">${l}</p>`)
            .join('');
        } else if (fav.Resumen) {
          instrEl.innerHTML = `<p class="text-gray-400 italic text-xs mb-3">Resumen:</p><p>${fav.Resumen.substring(0, 300)}...</p>`;
        } else {
          instrEl.textContent = 'Sin instrucciones disponibles.';
        }

        const ingredientes = Array.isArray(fav.Ingredientes) ? fav.Ingredientes : [];
        document.getElementById('modal-ingredients').innerHTML = ingredientes.map(ing => `
          <li class="flex items-center gap-3">
            <span class="w-2 h-2 bg-pink-200 rounded-full flex-shrink-0"></span>${ing}
          </li>
        `).join('');

        const badges = [];
        if (fav.Vegetariano) badges.push('🌿 Vegetariano');
        if (fav.Vegano)      badges.push('🌱 Vegano');
        if (fav.SinGluten)   badges.push('🌾 Sin gluten');
        if (fav.SinLacteos)  badges.push('🥛 Sin lácteos');
        document.getElementById('modal-badges').innerHTML = badges.map(b =>
          `<span class="bg-pink-50 text-pink-400 text-[10px] font-bold px-3 py-1 rounded-full">${b}</span>`
        ).join('');

        loading.classList.add('hidden');
        content.classList.remove('opacity-0');
        document.body.style.overflow = 'hidden';
      }

      // ✅ QUITAR FAVORITO DESDE EL MODAL
      async function toggleFavoritoModal() {
        if (!modalRecipeActual) return;
        const id = String(modalRecipeActual.RecipeID);

        try {
          const res = await fetch(`/favoritos/${id}`, { method: 'DELETE' });
          if (!res.ok) return;

          // Actualizar botón del modal
          document.getElementById('modal-fav-icon').classList.replace('fas', 'far');
          document.getElementById('modal-fav-icon').classList.remove('text-pink-500');
          document.getElementById('modal-fav-text').textContent = 'Quitado de favoritos';

          // Animar y quitar la card del grid
          const card = document.querySelector(`.recipe-card[data-id="${id}"]`);
          if (card) {
            card.style.transition = 'all 0.4s ease';
            card.style.opacity = '0';
            card.style.transform = 'scale(0.9)';
            setTimeout(() => {
              card.remove();
              const grid = document.getElementById('grid-favoritos');
              if (grid && grid.children.length === 0) {
                grid.outerHTML = `
                  <div class="flex flex-col items-center justify-center py-24 text-center">
                    <p class="text-7xl mb-6">🍰</p>
                    <h2 class="text-2xl font-bold cute-title text-gray-700 mb-4">Aún no tienes favoritas</h2>
                    <p class="text-gray-400 text-sm leading-relaxed mb-8 max-w-sm">
                      Explora las recetas y guarda las que más te gusten con el corazoncito 💕
                    </p>
                    <a href="/" class="bg-pink-500 text-white font-bold px-8 py-4 rounded-full shadow-lg hover:bg-pink-600 transition-all duration-300">
                      Explorar recetas ✨
                    </a>
                  </div>
                `;
              }
            }, 400);
          }

          setTimeout(() => closeModalBtn(), 600);

        } catch (err) {
          console.error('Error:', err);
        }
      }

      function closeModalBtn() {
        document.getElementById('modal-overlay').classList.add('hidden');
        document.getElementById('modal-overlay').classList.remove('flex');
        document.body.style.overflow = '';
      }

      function closeModal(event) {
        if (event.target === document.getElementById('modal-overlay')) closeModalBtn();
      }

      async function cerrarSesion() {
        await fetch('/logout', { method: 'POST' });
        window.location.href = '/';
      }

      document.addEventListener('keydown', e => {
        if (e.key === 'Escape') closeModalBtn();
      });